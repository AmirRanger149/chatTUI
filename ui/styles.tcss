Screen {
    background: #0f1718;
    color: #dce8e4;
}

#workspace {
    height: 1fr;
}

#sidebar {
    width: 31;
    background: #142021;
    border-right: solid #294042;
    padding: 2 2;
}

.brand {
    color: #8be1cb;
    text-style: bold;
    padding: 0 1 2 1;
}

.section-label, .message-label {
    color: #819694;
    text-style: bold;
    padding: 1 1 0 1;
}

#session-list {
    height: 1fr;
    margin: 1 0;
}

SessionItem {
    height: 3;
    padding: 1;
    color: #a9b9b7;
}

SessionItem.active {
    background: #243c3b;
    color: #a7efe0;
    border-left: thick #62c8b8;
}

Button {
    margin: 0 0 1 0;
    min-width: 16;
}

.shortcuts {
    color: #687b7a;
    padding: 1;
}

#chat-column {
    width: 1fr;
    padding: 0 4;
}

#chat-heading {
    height: 6;
    align: left middle;
    border-bottom: solid #294042;
}

#heading-copy {
    width: 1fr;
}

#session-subtitle, #input-hint {
    color: #75908d;
}

#heading-actions {
    align: right middle;
}

#model-label {
    color: #8be1cb;
    background: #1c3533;
    padding: 0 1;
    margin-right: 2;
}

#session-title {
    width: 1fr;
    color: #f0faf7;
    text-style: bold;
}

#open-settings {
    min-width: 12;
}

#conversation {
    height: 1fr;
    padding: 3 1;
    overflow-y: scroll;
    scrollbar-size-vertical: 1;
}

#welcome-panel {
    width: 100%;
    min-width: 1;
    margin: 8 0 0 2;
    padding: 2 3;
    border-left: thick #73d4bd;
    background: #152527;
}

.welcome-kicker {
    color: #73d4bd;
    text-style: bold;
}

.welcome-title {
    color: #f0faf5;
    text-style: bold;
    padding: 1 0;
}

.welcome-copy {
    color: #9bb0ad;
    width: 62;
    padding-bottom: 2;
}

.prompt-row {
    height: auto;
    layout: horizontal;
    overflow-x: hidden;
}

.prompt-row Button {
    width: 1fr;
    min-width: 10;
    margin-right: 1;
}

.message {
    width: 100%;
    padding: 1 2 2 2;
    margin: 0 0 2 0;
    border-left: thick #3c5555;
}

.message.user {
    background: #19302e;
    border-left: thick #73d4bd;
}

.message.assistant {
    background: #152022;
    border-left: thick #6f8b88;
}

.message-meta {
    height: 2;
    align: left middle;
}

.message-label {
    padding: 0 1 0 0;
    color: #b7cfca;
}

.message-state {
    color: #627d79;
}

.message Markdown {
    width: 100%;
    background: transparent;
    padding: 0;
    max-height: 18;
    overflow-y: hidden;
}

.message.expanded Markdown {
    max-height: 9999;
    overflow-y: auto;
}

.expand-message {
    display: none;
    min-width: 14;
    width: 14;
    margin: 1 0 0 0;
    color: #80d6c7;
    text-style: bold;
    padding: 0 1;
}

#status-line {
    height: 1;
    width: 1fr;
    color: #8db4aa;
}

#status-row {
    height: 2;
    align: left middle;
}

#chat-input {
    height: 5;
    width: 1fr;
    margin: 1 0 2 0;
    border: tall #3e6560;
    background: #142021;
}

#composer {
    height: 7;
    align: left middle;
}

#send-message {
    height: 5;
    min-width: 12;
    margin: 1 0 2 1;
    background: #73d4bd;
    color: #10201f;
}

#settings-dialog {
    width: 60;
    height: auto;
    padding: 2 3;
    background: #1c2728;
    border: round #62c8b8;
    margin: 0 0;
}

#settings-title {
    color: #a7efe0;
    text-style: bold;
    padding-bottom: 2;
}

#settings-dialog Input {
    margin: 0 0 1 0;
}

.modal-actions {
    align: right middle;
}
